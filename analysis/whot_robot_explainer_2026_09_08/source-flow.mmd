flowchart TB
    S(["玩家点击开始匹配"])
    S --> A["基础检查<br/>房间可用、人数支持、资产足够<br/>玩家不在牌桌或其他匹配中"]
    A --> B{"检查通过？"}
    B -- "否" --> FAIL0["拒绝进入匹配"]
    B -- "是" --> C["进入对应候选池<br/>不同场次、2人/4人、付费/免费分开排队"]
    C --> D{"玩家选择2人还是4人？"}

    subgraph MODES["两种人数模式并行匹配"]
      direction LR

      subgraph TWO["2人匹配｜允许机器人补位"]
        direction TB
        D -- "2人" --> T0["读取水位最终控制结果"]
        T0 --> T1{"是否命中更高优先级控制？<br/>如黑白名单、收益控制"}

        T1 -- "是" --> T3["必须匹配水位指定的机器人<br/>可能是必赢，也可能是必输"]
        T3 --> T4["等待约8～13秒<br/>8秒 + 随机0～5秒"]
        T4 --> BOTCHECK

        T1 -- "否" --> T5{"第一次随机<br/>基础RTP=90%，示例目标RTP=94%<br/>4.44%命中保护；95.56%普通匹配"}
        T5 -- "4.44%" --> TP0["必须匹配必输机器人<br/>机器人倾向输，真人倾向赢"]
        TP0 --> TP1["等待约8～13秒<br/>8秒 + 随机0～5秒"]
        TP1 --> BOTCHECK

        T5 -- "95.56%" --> TN0["进入普通真人队列<br/>优先寻找另一名真人"]
        TN0 --> TN1{"同一场次、同一付费类型中<br/>已有另一名真人？"}
        TN1 -- "是" --> TREAL["两名真人立即组成2人局"]
        TN1 -- "否" --> TN2["随机等待5～10秒<br/>期间继续优先等真人"]
        TN2 --> TN3{"等待期间有真人加入？"}
        TN3 -- "是" --> TREAL
        TN3 -- "否，到时间" --> TN4{"第二次随机<br/>选择补位机器人类型"}
        TN4 -- "52.63%" --> TN5["选择必赢机器人<br/>机器人倾向赢，真人倾向输"]
        TN4 -- "47.37%" --> TN6["选择必输机器人<br/>机器人倾向输，真人倾向赢"]
        TN5 --> BOTCHECK
        TN6 --> BOTCHECK{"指定类型机器人还有空闲？<br/>两类机器人都有数量上限"}
        BOTCHECK -- "有" --> TBOT["组成1真人+1机器人的2人局"]
        BOTCHECK -- "没有，已全部占用" --> FAILBOT["本次匹配失败<br/>房间解散"]

        TREAL --> TOK["2人候选牌桌确定"]
        TBOT --> TOK
      end

      subgraph FOUR["4人匹配｜每名真人加入前先做反作弊"]
        direction TB
        D -- "4人" --> F0["开始4人匹配<br/>建立空的4人候选组"]
        F0 --> F1["按等待顺序取下一名候选真人<br/>包括最先发起匹配的玩家"]
        F1 --> F2{"当前有候选真人吗？"}

        F2 -- "有" --> F3["在加入组合之前先审核<br/>检查本人状态，以及他与组内每个人的关系<br/>7天同桌1次：降权<br/>24小时2次或7天3次：硬拦截"]
        F3 --> F4{"本轮是否允许此人加入？"}
        F4 -- "允许" --> F6["把这名真人加入4人候选组"]
        F6 --> F7{"候选组达到4名真人？"}
        F4 -- "不允许" --> F5["不把此人加入当前组合<br/>硬拦截或Blocked：直接排除<br/>降权、Watch或Restricted：优先找更安全的人"]
        F5 -. "继续找下一名" .-> F1
        F7 -- "是" --> F8["4名已通过审核的真人<br/>直接组成4人局"]
        F7 -- "否" --> F9["记录当前人数<br/>继续等待新真人"]

        F2 -- "暂时没有" --> F9
        F9 --> F10{"先发生哪件事？"}
        F10 -- "新真人出现" --> F1
        F10 -- "当前人数稳定满5秒" --> FS["发起第一轮降级询问<br/>玩家有5秒决定"]
        F10 -- "等待达到45秒" --> FAIL4["匹配超时<br/>房间解散"]

        FS --> FC{"当前候选组有几名真人？"}
        FC -- "1人或2人" --> F20["询问当前所有真人<br/>是否同意降成2人匹配"]
        F20 --> F21{"需要决定的真人全部同意？"}
        F21 -- "是" --> FTO2["退出4人候选组<br/>直接转入完整的2人匹配流程"]
        FTO2 -. "从2人流程入口重新匹配" .-> T0
        F21 -- "拒绝或超时" --> FN["本轮没有成功降级"]

        FC -- "3人" --> F30["询问3名真人<br/>是否同意组成3人局"]
        F30 --> F31{"3人全部同意？"}
        F31 -- "是" --> F32["3名已通过审核的真人<br/>立即组成3人局"]
        F31 -- "否" --> F33["等到本轮截止<br/>统计最终同意人数"]
        F33 --> F34{"截止时恰好2人同意？"}
        F34 -- "是" --> FTO2
        F34 -- "否" --> FN

        FN --> F35{"这是第一轮还是最后一轮？"}
        F35 -- "第一轮" --> F36["继续等待真人<br/>新真人仍必须先通过反作弊<br/>第35～45秒进入最后一轮"]
        F36 --> F37{"先发生哪件事？"}
        F37 -- "新真人出现" --> F1
        F37 -- "进入最后一轮" --> F38["按当前真人数量再次询问<br/>最晚第45秒结束"]
        F38 --> FC
        F35 -- "最后一轮" --> FAIL4

        F8 --> FOK["4人候选牌桌确定"]
        F32 --> FOK
      end

      T0 ~~~ F0
      TOK ~~~ FOK
    end

    TOK --> READY
    FOK --> READY["锁定参与者并在开桌前复查<br/>付费/免费类型一致<br/>3人、4人关系仍然安全"]
    READY --> R1{"复查通过？"}
    R1 -- "否" --> FAILROOM["本次匹配失败<br/>房间解散"]
    R1 -- "是" --> R2["创建牌桌并通知玩家进入"]
    R2 --> END(["匹配成功"])

    CANCEL["锁定前：玩家可以取消匹配<br/>锁定并开始建桌后：不能取消，只能进入牌桌"]
    READY -.-> CANCEL

    classDef start fill:#dcfce7,stroke:#16a34a,color:#14532d,stroke-width:2px;
    classDef action fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e;
    classDef decide fill:#fef3c7,stroke:#d97706,color:#78350f;
    classDef robot fill:#f3e8ff,stroke:#9333ea,color:#581c87;
    classDef wait fill:#ffedd5,stroke:#ea580c,color:#7c2d12;
    classDef fail fill:#fee2e2,stroke:#dc2626,color:#7f1d1d,stroke-width:2px;
    classDef check fill:#fce7f3,stroke:#db2777,color:#831843;
    classDef note fill:#f1f5f9,stroke:#64748b,color:#0f172a;

    class S,END start;
    class A,C,T0,T3,TREAL,TBOT,TOK,F0,F1,F6,F8,FTO2,F32,FOK,READY,R2 action;
    class B,D,T1,T5,TN1,TN3,TN4,BOTCHECK,F2,F4,F7,F10,FC,F21,F31,F34,F35,F37,R1 decide;
    class TP0,TN5,TN6 robot;
    class T4,TP1,TN0,TN2,F5,F9,FS,F20,F30,F33,F36,F38 wait;
    class FAIL0,FAILBOT,FAIL4,FAILROOM fail;
    class F3 check;
    class CANCEL note;