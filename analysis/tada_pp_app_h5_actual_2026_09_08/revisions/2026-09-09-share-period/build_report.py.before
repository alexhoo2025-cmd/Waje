mdparts=[]
for b in M['blocks']:
 if b['type']=='markdown':mdparts.append(b['body'])
 elif b['type']=='table':
  t=tables[b['tableId']];cols=t['columns'];rows=DATA[t['dataset']]
  if b['tableId']=='full-games':mdparts.append('完整共同游戏对照见附件「共同游戏对照.csv」。');continue
  mdparts.append('### '+t['title']+'\n\n'+'| '+' | '.join(c['label'] for c in cols)+' |\n'+'| '+' | '.join('---' for c in cols)+' |\n'+'\n'.join('| '+' | '.join(str(r.get(c['field'],'')) for c in cols)+' |' for r in rows))
 elif b['type']=='chart':mdparts.append(f"![{charts[b['chartId']]['title']}](lark-assets/{b['id']}.png)")
(P/'报告.md').write_text('\n\n'.join(mdparts)+'\n')
