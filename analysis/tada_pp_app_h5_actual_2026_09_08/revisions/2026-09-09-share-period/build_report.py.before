selected=[]
for v in ['Tada','PP']:selected.extend([r for r in common if r['provider']==v][:5])
game_rows=[{'厂商':r['provider'],'游戏':r['game_name'],'APP下注额（亿）':yi(r['app_stake']),'H5下注额（亿）':yi(r['h5_stake']),'APP厂商内占比':pct(r['app_share']),'H5厂商内占比':pct(r['h5_share'])} for r in selected]
table('top-games','同游戏跨渠道对照：每厂商前5款',game_rows,[(k,k) for k in game_rows[0]],subtitle='按APP＋H5合计下注额选取；占比的分母为该渠道该厂商下注额。')
