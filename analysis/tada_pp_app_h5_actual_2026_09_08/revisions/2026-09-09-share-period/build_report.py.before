 'accessIssues':[{'source':'final_withdraw_and_loading','message':'下注与回访主分析已完成；最终到账TC、现金/奖励拆分及加载关联证据仍缺失。'}], 'datasets':DATA}}
(P/'artifact.json').write_text(json.dumps(artifact,ensure_ascii=False,indent=2)+'\n')
(P/'chart-map.json').write_text(json.dumps(CHART_MAP,ensure_ascii=False,indent=2)+'\n')
