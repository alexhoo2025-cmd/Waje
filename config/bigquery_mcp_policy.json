{
  "schema_version": 1,
  "status": "blocked_pending_external_prerequisites",
  "project_id": "wajenigeria",
  "policy_mode": "fail_closed",
  "remote_mcp": {
    "endpoint": "https://bigquery.googleapis.com/mcp",
    "trusted": false,
    "allowed_tools": [
      "list_dataset_ids",
      "get_dataset_info",
      "list_table_ids",
      "get_table_info",
      "execute_sql_readonly"
    ],
    "denied_tools": [
      "execute_sql"
    ]
  },
  "execution_roles": {
    "bigquery_api": "deterministic scheduled checks, dry runs, fixed query templates and receipts",
    "remote_mcp": "schema discovery and approved aggregate-only exploratory analysis",
    "llm": "query drafting and interpretation only after all policy gates pass"
  },
  "limits": {
    "max_bytes_per_query": 5368709120,
    "max_bytes_per_audit": 26843545600,
    "max_rows": 3000,
    "minimum_group_size": 10,
    "timeout_seconds": 180
  },
  "sql_policy": {
    "allowed_statement_starts": ["select", "with"],
    "forbidden_operations": [
      "insert", "update", "delete", "merge", "create", "drop", "alter",
      "truncate", "export", "load", "call", "grant", "revoke",
      "execute immediate", "script", "python"
    ],
    "require_date_predicate": true,
    "date_predicate_fields": [
      "event_date", "report_date", "cohort_date", "date", "dt",
      "year_day", "_partitiondate", "event_time", "event_timestamp"
    ],
    "forbid_select_star": true,
    "require_limit": true,
    "forbidden_identifiers": [
      "user_id", "uuid", "phone", "phone_number", "email", "bvn", "nin",
      "biometric", "face_image", "document_image", "account_number", "bank_account",
      "order_id", "device_id", "advertising_id", "ip", "token", "cookie",
      "raw_response", "third_party_raw_response"
    ]
  },
