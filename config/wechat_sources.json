{
  "schema_version": 1,
  "enabled": true,
  "account_name": "",
  "api": {
    "base_url_env": "WECHAT_ARTICLE_API_BASE",
    "token_env": "WECHAT_ARTICLE_API_TOKEN",
    "list_path": "/articles",
    "detail_path": "/articles/{article_id}",
    "timeout_seconds": 45,
    "page_size": 50
  },
  "fallback": {
    "incoming_dir": "data/incoming/wechat",
    "accepted_extensions": [".json", ".jsonl", ".html", ".htm", ".zip", ".pdf"]
  }
}
