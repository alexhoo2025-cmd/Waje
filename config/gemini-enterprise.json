{
  "schema_version": 1,
  "mode": "enterprise_web_primary",
  "preferred_execution_backend": "enterprise_web_agent",
  "execution_policy": {
    "delegate_by_default": false,
    "cli_normal_invocation_enabled": false,
    "availability": "backend_specific",
    "web_agent": {
      "enabled_for_complex_tasks": true,
      "availability": "user_confirmed_operational",
      "confirmation_source": "user_feedback_2026-09-04",
      "note": "用户确认网页Agent执行效果较好，偶尔需账户或凭证验证；不受本地CLI恢复门禁影响。",
      "authentication_handling": "resume_same_authorized_account_session"
    },
    "review_window": "2026-08-22/2026-09-04",
    "routing_note": "仅复杂交互任务按能力分派；Claude负责分析、数据处理、设计与代码，Gemini网页Agent可承担企业资料/授权查询等专项。简单日常任务不分派。只有本地Gemini CLI保持恢复门禁。",
    "enterprise_token_budget": "unconstrained_by_codex",
    "codex_role": [
      "task_router",
      "metric_and_source_auditor",
      "final_deliverable_editor"
    ],
    "delegate_when": [
      "public_web_research",
      "long_document_synthesis",
      "authorized_bigquery_aggregate_analysis",
      "multi_source_comparison",
      "first_draft_reporting"
    ],
    "keep_in_codex_when": [
      "simple_copyediting",
      "local_file_patch_or_validation",
      "final_metric_definition_and_quality_audit"
    ],
    "handoff_contract": "Gemini may reason at full depth. Return a concise decision summary plus structured evidence, source URLs or approved aggregate metrics, quality status, and open questions for Codex audit."
  },
  "project_id": "wajenigeria",
  "data_project_id": "wajenigeria",
  "runtime_project_id": "indigo-gecko-500503-j3",
  "location": "us-central1",
  "data_location": "europe-west4",
  "firebase_source_scope": {
    "mode": "firebase_only",
    "project_id": "wajenigeria",
    "approved_dataset_allowlist": [
      "wajenigeria.waje_ng_firebase_android",
      "wajenigeria.waje_ng_firebase_android_performance",
      "wajenigeria.waje_ng_firebase_android_sessions",
      "wajenigeria.waje_ng_firebase_android_crashlytics",
      "wajenigeria.waje_ng_firebase_ios",
      "wajenigeria.waje_ng_firebase_ios_performance",
      "wajenigeria.waje_ng_firebase_h5"
    ],
    "raw_rows_allowed": false,
    "requires_aggregate_output": true
  },
  "enterprise_identity_required": true,
  "auth_profile": "enterprise-gemini",
  "mcp_policy_path": "config/bigquery_mcp_policy.json",
  "gemini_command": ["gemini"],
  "approval_mode": "plan",
  "output_format": "json",
  "preferred_models": {
    "default": "gemini-3.8-flash",
    "complex_analysis": "gemini-3.1-pro-preview",
    "web_research": "gemini-3.8-flash",
    "competitor_intelligence": "gemini-3.1-pro-preview"
  },
  "model_fallback": {
    "enabled": true,
    "models": [
      "gemini-3.8-flash",
      "gemini-3.7-flash"
    ],
    "allow_cli_default": false,
    "max_attempts": 2,
    "retry_on": [
      "model_unavailable",
      "model_transient",
      "failed_timeout",
      "failed_invalid_json"
    ],
    "note": "企业 CLI 的默认模型为 gemini-3.8-flash，仅在模型不可用、短暂故障、超时或无效 JSON 时回退 gemini-3.7-flash。Agent Platform 的独立模型选择由 agent_platform.model 管理；权限、许可证和 SQL 安全错误不通过换模型规避。"
  },
  "agent_platform": {
    "agent_name": "Waje 端侧设备与性能分析助手",
    "agent_id": "waje-device-performance-analyst-v1",
    "design_project_id": "wajenigeria",
    "model": "gemini-3.1-pro-preview",
    "model_fallback": ["gemini-2.5-pro"],
    "model_location": "global",
    "agent_runtime_region_preference": "us-west1",
    "thinking_level": "MEDIUM",
    "privacy_mode": "aggregate_only",
    "daily_monitor": {
      "timezone": "Africa/Lagos",
      "schedule": "0 13 * * *",
      "external_notifications": false
    },
    "web_tools": {
      "google_search": true,
      "url_context": true,
      "scope": "public_sources_only",
      "evidence_fields": [
        "source_url",
        "title",
        "published_at",
        "retrieved_at",
        "evidence_level",
        "claim_boundary"
      ],
      "note": "Public web research complements, but never replaces, approved BigQuery aggregate facts."
    },
    "safe_views": [
      "wajenigeria.agent_analytics.vw_firebase_endpoint_coverage_daily_safe",
      "wajenigeria.agent_analytics.vw_firebase_event_session_daily_safe",
      "wajenigeria.agent_analytics.vw_firebase_native_performance_daily_safe",
      "wajenigeria.agent_analytics.vw_firebase_stability_daily_safe",
      "wajenigeria.agent_analytics.vw_firebase_h5_behavior_daily_safe"
    ]
  },
  "web_execution": {
    "base_url": "https://vertexaisearch.cloud.google.com",
    "agents": {
      "public_research": "Deep Research",
      "data_query": "Data Execution Agent",
      "analysis": "Deep Analysis Agent",
      "orchestration": "Master Orchestrator",
      "product_context": "Robin-PM"
    },
    "output_policy": "Store only public source facts or approved aggregate results. Never copy browser cookies, account details, raw internal rows, or uploaded-file contents into the project.",
    "fallback_status": "web_execution_required"
  },
  "timezone": "Africa/Lagos",
  "default_window_days": 7,
  "max_complete_days": 7,
  "limits": {
    "max_bytes_billed": 5368709120,
    "max_rows": 3000,
    "max_result_bytes": 3000000,
    "timeout_seconds": 180
  },
  "allowed_datasets": [],
  "allowed_views": [],
  "sensitive_identifiers": [
    "user_id",
    "uuid",
    "phone",
